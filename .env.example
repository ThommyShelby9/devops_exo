# ============================================
# MedSecure - Variables d'environnement LOCAL
# ============================================
# Copiez ce fichier vers .env et ajustez les valeurs

# Base de données SQL Server
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=MedSecure2024!
SQL_DATABASE_CATALOG=MedSecureDB
SQL_DATABASE_IDENTITY=MedSecureIdentity

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@medsecure.local

# Application
ASPNETCORE_ENVIRONMENT=Development
ENABLE_SWAGGER=true
